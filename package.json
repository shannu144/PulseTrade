{
  "name": "pulsetrade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"APP,WS\" -c \"cyan,magenta\" \"vite\" \"tsx server/simulatorServer.ts\"",
    "dev:app": "vite",
    "dev:server": "tsx server/simulatorServer.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
